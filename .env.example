# ==============================================================================
# Admin CMS Next.js App Environment Variables Template
# ==============================================================================

NODE_ENV="development"

# ------------------------------------------------------------------------------
# 1. NextAuth.js (Auth.js v5) Configuration
# ------------------------------------------------------------------------------
# Primary secret used to encrypt session tokens/cookies (min 32 characters)
AUTH_SECRET="dev-secret-do-not-use-in-production"

# Absolute URL of the Admin CMS application
NEXTAUTH_URL="http://localhost:4001"
AUTH_URL="http://localhost:4001"

# Trust headers from reverse proxies (required when hosted behind Nginx/Cloudflare)
AUTH_TRUST_HOST="true"

# ------------------------------------------------------------------------------
# 2. Admin Session Control Policies & JWT
# ------------------------------------------------------------------------------
JWT_ADMIN_SECRET="dev-jwt-admin-secret-do-not-use-in-production"
JWT_SECRET="dev-jwt-secret-do-not-use-in-production"
ADMIN_SESSION_MAX_AGE_DAYS=7
ADMIN_SESSION_ABSOLUTE_TIMEOUT_HOURS=72
ADMIN_SESSION_IDLE_TIMEOUT_HOURS=2
ADMIN_SESSION_CACHE_TTL_SEC=15
ADMIN_MAX_SESSIONS_PER_USER=5

# ------------------------------------------------------------------------------
# 3. Client / Public Parameters (Exposed to Browser)
# ------------------------------------------------------------------------------
# Backend NestJS API Endpoint
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Self Frontend Admin CMS Endpoint
NEXT_PUBLIC_APP_URL="http://localhost:4001"
